# Copy this file to .env.production on the server.
# Never commit the real .env.production file.

POSTGRES_PASSWORD=replace_with_a_strong_database_password

CORS_ORIGIN=https://hub.huyenvu.cloud,https://h5.zdn.vn
NEXT_PUBLIC_API_URL=https://api-hub.huyenvu.cloud

# Development login should remain disabled on Internet-facing environments.
ALLOW_DEV_AUTH=false

# Safer first Zalo bootstrap:
# Temporarily true only while the database has exactly 1 active user and 0 linked Zalo users.
# After the first successful Zalo login/link, set this back to false immediately.
ALLOW_FIRST_ZALO_BOOTSTRAP=false

SESSION_SECRET=replace_with_at_least_32_random_characters

# Zalo Social OAuth V4
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=https://api-hub.huyenvu.cloud/v1/auth/zalo/callback
ZALO_AUTH_SUCCESS_REDIRECT=https://hub.huyenvu.cloud/auth/zalo/callback

# Zalo Mini App
ZALO_MINI_APP_ID=

# Zalo Official Account OAuth
# Generate a private PKCE verifier with 43-128 URL-safe characters and keep it server-side.
# The Admin page derives and displays the public Code Challenge for Zalo Developers.
ZALO_OA_REDIRECT_URI=https://api-hub.huyenvu.cloud/v1/integrations/zalo/oa/callback
ZALO_OA_SUCCESS_REDIRECT=https://hub.huyenvu.cloud/integrations/zalo
ZALO_OA_CODE_VERIFIER=
# Optional: only required when validating OA webhook signatures.
ZALO_OA_WEBHOOK_SECRET=
