generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_MANAGER
  DOCTOR
  NURSE
  STAFF
  VIEWER
}

enum ZaloOAuthMode {
  LOGIN
  LINK
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum ConsultationPriority {
  ROUTINE
  URGENT
}

enum ConsultationStatus {
  OPEN
  CLOSED
}

enum InternalFileScope {
  ALL
  DEPARTMENT
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  users         User[]
  announcements Announcement[] @relation("AnnouncementTargetDepartment")
  consultations ConsultationCase[]
  files         InternalFile[]
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              String          @id @default(cuid())
  employeeCode    String          @unique
  fullName        String
  email           String?         @unique
  phone           String?
  zaloUserId      String?         @unique
  zaloDisplayName String?
  zaloAvatarUrl   String?
  role            UserRole        @default(STAFF)
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  isActive        Boolean         @default(true)
  lastLoginAt     DateTime?
  lastZaloLoginAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  auditLogs       AuditLog[]      @relation("AuditActor")
  zaloFlows       ZaloOAuthFlow[]
  authTickets     AuthTicket[]
  announcementsAuthored Announcement[]     @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  consultationsOwned    ConsultationCase[]   @relation("ConsultationOwner")
  consultationMemberships ConsultationParticipant[]
  consultationMessages  ConsultationMessage[]
  uploadedFiles          InternalFile[]          @relation("InternalFileUploader")

  @@index([departmentId])
  @@index([fullName])
}

model ZaloOAuthFlow {
  id           String        @id @default(cuid())
  state        String        @unique
  codeVerifier String
  mode         ZaloOAuthMode
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model AuthTicket {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model Announcement {
  id                 String               @id @default(cuid())
  title              String
  body               String
  priority           AnnouncementPriority @default(NORMAL)
  authorId           String
  author             User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targetDepartmentId String?
  targetDepartment   Department?          @relation("AnnouncementTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  publishedAt        DateTime             @default(now())
  expiresAt          DateTime?
  isActive           Boolean              @default(true)
  reads              AnnouncementRead[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([isActive, publishedAt])
  @@index([targetDepartmentId, publishedAt])
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId, readAt])
}


model ConsultationCase {
  id           String               @id @default(cuid())
  title        String
  summary      String
  priority     ConsultationPriority @default(ROUTINE)
  status       ConsultationStatus   @default(OPEN)
  ownerId      String
  owner        User                 @relation("ConsultationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  participants ConsultationParticipant[]
  messages     ConsultationMessage[]
  closedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, updatedAt])
  @@index([ownerId, updatedAt])
  @@index([departmentId, updatedAt])
}

model ConsultationParticipant {
  consultationId String
  consultation   ConsultationCase @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime         @default(now())

  @@id([consultationId, userId])
  @@index([userId, joinedAt])
}

model ConsultationMessage {
  id             String           @id @default(cuid())
  consultationId String
  consultation   ConsultationCase @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime         @default(now())

  @@index([consultationId, createdAt])
  @@index([authorId, createdAt])
}


model InternalFile {
  id           String            @id @default(cuid())
  originalName String
  storedName   String            @unique
  mimeType     String
  sizeBytes    Int
  scope        InternalFileScope @default(DEPARTMENT)
  uploaderId   String
  uploader     User              @relation("InternalFileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([scope, departmentId, createdAt])
  @@index([uploaderId, createdAt])
}
