# Database
DATABASE_URL="postgresql://hospital:change_me@localhost:5432/hospital_hub?schema=public"

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://h5.zdn.vn
ALLOW_DEV_AUTH=true

# Admin / client
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# Zalo Social OAuth V4
# ZALO_APP_ID is the Zalo application ID, NOT the Mini App ID.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:4000/v1/auth/zalo/callback
ZALO_AUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/zalo/callback

# Zalo OA - kept separate from Social OAuth
ZALO_OA_ID=
ZALO_OA_SECRET=

# Security
# Production: use a long random secret and set ALLOW_DEV_AUTH=false.
SESSION_SECRET=replace_with_a_long_random_secret
